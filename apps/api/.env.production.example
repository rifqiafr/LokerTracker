# Port server (Render / Railway akan menyediakan otomatis jika tidak diisi)
PORT=5000

# Database URL PostgreSQL (Contoh dari Supabase / Neon.tech)
DATABASE_URL="postgresql://postgres:password_anda@db.host.supabase.co:5432/postgres?sslmode=require"

# Kunci rahasia JWT untuk autentikasi user
JWT_SECRET="loker_production_jwt_secret_ganti_dengan_string_acak_panjang"

# URL domain Frontend Vercel (untuk konfigurasi CORS)
CLIENT_ORIGIN="https://loker-tracker.vercel.app"
